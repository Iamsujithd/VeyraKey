{
  "name": "veyrakey-extension",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@zk-wallet/crypto": "workspace:*",
    "@zk-wallet/persistence": "workspace:*",
    "@zk-wallet/provider-drive": "workspace:*",
    "@zk-wallet/security": "workspace:*",
    "@zk-wallet/sync": "workspace:*",
    "@zk-wallet/ui": "workspace:*",
    "@zk-wallet/vault": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@wxt-dev/module-react": "1.2.2",
    "wxt": "0.20.27"
  },
  "scripts": {
    "build": "pnpm run build:chrome && pnpm run build:firefox",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "dev": "wxt -b chrome",
    "postinstall": "wxt prepare",
    "release:package": "wxt zip -b chrome --mv3 --sources && wxt zip -b firefox --mv3",
    "typecheck": "wxt prepare && tsc --noEmit -p tsconfig.json"
  }
}
