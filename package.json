{
  "name": "zero-knowledge-security-wallet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "24.11.0",
    "pnpm": "11.10.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "build:site": "pnpm --dir apps/web build && node tooling/build-sites.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:artifacts",
    "dev:api": "pnpm --dir apps/api dev",
    "dev:extension": "pnpm --dir apps/extension dev",
    "dev:web": "pnpm --dir apps/web dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "verify:artifacts": "node tooling/verify-artifacts.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.9.0",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
